{
  "contractVersion": 1,
  "language": "typescript",
  "ci": { "runner": "ubuntu-24.04", "node": "24" },
  "setup": [
    { "name": "install", "command": "npm ci && npx playwright install chromium", "timeoutSec": 600 }
  ],
  "checks": [
    { "name": "lint", "command": "node --run lint", "timeoutSec": 180 },
    { "name": "format", "command": "node --run format:check", "timeoutSec": 120 },
    { "name": "types", "command": "node --run types", "timeoutSec": 300 },
    { "name": "unit", "command": "node --run test", "timeoutSec": 600 }
  ],
  "e2e": { "applies": false },
  "paths": {
    "specsDir": "specs",
    "allowed": ["src/**", "test/**", "dev/**", "specs/**", "package.json", "package-lock.json"],
    "protected": [],
    "tests": ["test/**"],
    "checkDefinitions": ["vite.config.ts", "tsconfig.json", "oxlint.config.ts", "oxfmt.config.ts", "test/__helpers__/setup.ts"],
    "sensitive": ["package.json", "package-lock.json"]
  },
  "env": { "required": [] }
}
